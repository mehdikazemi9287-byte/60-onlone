# Copy to deploy/.env (setup.sh does it and fills the secrets). Never commit .env.

# ── Domains & TLS ──
MAIN_DOMAIN=60online.ir
VAMBI_DOMAIN=vambi.ir
ACME_EMAIL=ops@60online.ir
PUBLIC_BASE_URL=https://60online.ir
CORS_ORIGINS=https://60online.ir,https://vambi.ir

# ── Secrets (setup.sh generates) ──
SECRET_KEY=
POSTGRES_PASSWORD=

# ── Payment (Sepehr) — required before sales open ──
PAYMENT_PROVIDER=sepehr
SEPEHR_TERMINAL_ID=

# ── SMS login (Kavenegar verify template with one %token) ──
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=sixty-otp
OTP_DAILY_SMS_CAP=3000

# ── Closed ecosystem / B2B start ──
# Owner decision 1405/08/21: public prices are public. Organization (contract) and wholesale (B2B) tiers are
# always shown only to their eligible members, whatever this value is.
STOREFRONT_PRICE_VISIBILITY=public
EXTERNAL_CHANNELS_ENABLED=0
STOREFRONT_SALES_ENABLED=0
LEGAL_REQUIRE_BUYER_TERMS=1
DEMO_MODE=0
SEED_ON_START=0
RATE_LIMIT_PER_MINUTE=120
GUNICORN_THREADS=8

# ── Backups ──
BACKUP_HOST_DIR=/var/backups/sixty
BACKUP_KEEP_DAYS=14
# off-site (strongly recommended): an rclone remote defined in $BACKUP_HOST_DIR/rclone.conf, e.g. Arvan object storage
BACKUP_RCLONE_REMOTE=

# ── Alerts (Bale or Telegram bot) ──
ALERT_BOT_URL=
ALERT_CHAT_ID=
ALERT_HOST_NAME=60online-prod

# ── Vambi (sister product, server-to-server) ──
# Read-only feed GET /api/v1/feeds/vambi/products: off (404) while empty. >= 32 random chars; comma-separated for rotation.
VAMBI_FEED_TOKEN=
VAMBI_FEED_RATE_PER_MIN=60
# Shared login (/sso/vambi → vambi.ir/sso/callback): exact https origins only.
SSO_ALLOWED_ORIGINS=https://vambi.ir,https://www.vambi.ir
